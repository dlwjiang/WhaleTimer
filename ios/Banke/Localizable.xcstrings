    "An optional intention for this session.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An optional intention for this session."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この時間に取り組むことを、自由に書けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 시간에 할 일을 적어 보세요. 선택 사항이에요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以写下本轮想做的事，也可以留空。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以寫下本輪想做的事，也可以留空。"
          }
