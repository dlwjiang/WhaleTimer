            "state": "translated",
            "value": "Start a fresh focus session?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集中タイマーをリセットしますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집중 타이머를 다시 시작할까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
