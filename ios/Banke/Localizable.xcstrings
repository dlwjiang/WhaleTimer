    "Couldn’t finish the purchase. Retry, or restore purchases if you were charged.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t finish the purchase. Retry, or restore purchases if you were charged."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入を完了できませんでした。再試行するか、お支払い済みなら購入を復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매를 완료하지 못했어요. 다시 시도하거나 결제되었다면 구매를 복원해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法完成购买。请重试；如已扣款，请恢复购买。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法完成購買。請重試；如已扣款，請回復購買。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar la compra. Reintenta o restaura las compras si se te cobró."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível concluir a compra. Tente novamente ou restaure se houve cobrança."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de terminer l’achat. Réessayez ou restaurez les achats si vous avez été débité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kauf konnte nicht abgeschlossen werden. Versuche es erneut oder stelle Käufe wieder her, falls du bezahlt hast."
          }
        }
      }
    },
