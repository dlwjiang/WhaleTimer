    "Long breaks follow four focus sessions. If long breaks are off, an enabled short break takes their place. With both off, continue to your next focus session. Running and paused sessions keep their remaining time.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long breaks follow four focus sessions. If long breaks are off, an enabled short break takes their place. With both off, continue to your next focus session. Running and paused sessions keep their remaining time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集中を4回終えると長い休憩になります。長い休憩をオフにすると、短い休憩がオンなら代わりに入ります。両方オフなら次の集中に進みます。実行中や一時停止中の残り時間は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집중을 네 번 마치면 긴 휴식을 취해요. 긴 휴식을 끄면 켜져 있는 짧은 휴식으로 대신해요. 둘 다 끄면 다음 집중으로 넘어가요. 진행 중이거나 일시 정지한 세션의 남은 시간은 유지돼요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每完成四轮专注后安排长休息。关闭长休息后，若短休息开启，则改为短休息。两者都关闭时，直接进入下一轮专注。正在进行或暂停的计时保留剩余时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每完成四輪專注後安排長休息。關閉長休息後，若短休息開啟，則改為短休息。兩者都關閉時，直接進入下一輪專注。正在進行或暫停的計時保留剩餘時間。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay un descanso largo cada cuatro sesiones. Si lo desactivas, se sustituye por uno corto si está activado. Si desactivas ambos, pasas a la siguiente sesión de concentración. Las sesiones en curso o pausadas conservan el tiempo restante."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pausa longa vem após quatro sessões. Se estiver desativada, uma pausa curta a substitui, se estiver ativada. Com ambas desativadas, você segue para a próxima sessão de foco. Sessões em andamento ou pausadas mantêm o tempo restante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une pause longue suit quatre sessions. Si elle est désactivée, une pause courte la remplace si elle est activée. Si les deux sont désactivées, vous passez à la prochaine session de concentration. Les sessions en cours ou suspendues gardent leur temps restant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach vier Fokusphasen folgt eine lange Pause. Ist sie ausgeschaltet, tritt eine eingeschaltete kurze Pause an ihre Stelle. Sind beide aus, folgt die nächste Fokusphase. Laufende und pausierte Sitzungen behalten ihre Restzeit."
          }
        }
      }
    },
    "Well done! Ready when you are.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Well done! Ready when you are."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おつかれさま！準備ができたら、また始めよう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘했어! 준비되면 시작하자."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "做得好！准备好了就继续吧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "做得好！準備好了就繼續吧。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Muy bien! Cuando quieras, seguimos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muito bem! Quando quiser, continuamos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bravo ! On reprend quand tu veux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gut gemacht! Weiter, wenn du bereit bist."
          }
        }
      }
    },
    "Your focus session is complete. %@ is ready when you are.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your focus session is complete. %@ is ready when you are."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "集中の時間が終わりました。準備ができたら、%@とまた始めましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집중 시간이 끝났어요. 준비되면 %@와 다시 시작해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本轮专注已完成。准备好了就和%@继续吧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本輪專注已完成。準備好了就和%@繼續吧。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sesión de concentración ha terminado. %@ está listo para seguir contigo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua sessão de foco terminou. %@ espera por você para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre session de concentration est terminée. %@ vous attend pour la suite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Fokusphase ist abgeschlossen. %@ wartet auf dich."
          }
        }
      }
    },
