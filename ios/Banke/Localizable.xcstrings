          "stringUnit": {
            "state": "translated",
            "value": "歇一会儿，我等你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歇一會兒，我等你。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toma un respiro. Te espero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Respira um pouco. Eu espero."
          }
        },
        "fr": {
