          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este pack no está disponible. Inténtalo más tarde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este pacote está indisponível. Tente mais tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce pack est indisponible. Réessayez plus tard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Paket ist nicht verfügbar. Bitte später erneut versuchen."
          }
        }
      }
    },
    "Awaiting approval. Companions unlock when the App Store confirms the purchase.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Awaiting approval. Companions unlock when the App Store confirms the purchase."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認待ちです。App Storeで購入が確認されると、おともが使えるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인 대기 중이에요. App Store에서 구매가 확인되면 친구들이 잠금 해제돼요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待批准。App Store 确认购买后即可解锁伙伴。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待核准。App Store 確認購買後即可解鎖夥伴。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendiente de aprobación. Los compañeros se desbloquean al confirmar el App Store la compra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando aprovação. Os companheiros serão liberados quando a App Store confirmar a compra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente d’approbation. Les compagnons se débloquent quand l’App Store confirme l’achat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten auf Genehmigung. Begleiter werden nach der Kaufbestätigung des App Store freigeschaltet."
          }
        }
      }
    },
    "The purchase hasn’t completed. Please try again later.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The purchase hasn’t completed. Please try again later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入が完了していません。後でもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매가 완료되지 않았어요. 나중에 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买尚未完成，请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "購買尚未完成，請稍後重試。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La compra no se ha completado. Inténtalo más tarde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A compra não foi concluída. Tente mais tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’achat n’est pas terminé. Réessayez plus tard."
          }
        },
        "de": {
          "stringUnit": {
