    "A warm window for your late-night ideas.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A warm window for your late-night ideas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夜更けのひらめきに、あたたかな窓明かりを。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "늦은 밤 떠오르는 생각을 위한 따뜻한 창가."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为深夜灵感，留一扇暖暖的窗。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為深夜靈感，留一扇暖暖的窗。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una ventana cálida para tus ideas nocturnas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma janela acolhedora para suas ideias da madrugada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fenêtre chaleureuse pour tes idées nocturnes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein warmes Fenster für deine nächtlichen Ideen."
          }
        }
      }
    },
