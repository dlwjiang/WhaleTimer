        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の一歩、準備はいい？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 한 걸음, 준비됐어?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备好开启下一小步了吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
