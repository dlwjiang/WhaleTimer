    "%@ is ready for a break. Your focus session is complete.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is ready for a break. Your focus session is complete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@とひと休みしましょう。集中セッションが終わりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@도 쉴 준비가 됐어요. 집중 세션이 끝났어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 准备休息啦。本轮专注已完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 準備休息啦。本輪專注已完成。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está listo para descansar. Tu sesión ha terminado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está pronto para descansar. Sua sessão terminou."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est prêt pour une pause. Ta session est terminée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist bereit für eine Pause. Deine Fokussitzung ist beendet."
          }
        }
      }
    },
    "Your break is over. %@ is waiting in your study corner.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your break is over. %@ is waiting in your study corner."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "休憩が終わりました。%@が待っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쉬는 시간이 끝났어요. %@가 기다리고 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "休息结束啦，%@ 正在专注角落等你。"
