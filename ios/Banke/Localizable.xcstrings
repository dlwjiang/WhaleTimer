    "Captions remain visible when muted. Voices follow your selected language.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Captions remain visible when muted. Voices follow your selected language."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "消音中も字幕が表示されます。声は選んだ言語に合わせて変わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리를 꺼도 자막은 보여요. 목소리는 선택한 언어를 따라가요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
