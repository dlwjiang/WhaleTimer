            "state": "translated",
            "value": "Las notificaciones están desactivadas. Actívalas en Ajustes de iOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações estão desativadas. Ative-as nos Ajustes do iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications sont désactivées. Activez-les dans les Réglages iOS."
          }
        },
        "de": {
