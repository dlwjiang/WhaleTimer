    "Your timer stays on this device. No account or ads. Purchases use the App Store.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your timer stays on this device. No account or ads. Purchases use the App Store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイマーはこのデバイスに保存されます。アカウントや広告はありません。購入にはApp Storeを使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타이머는 이 기기에 저장돼요. 계정이나 광고는 없어요. 구매는 App Store를 이용해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计时数据保存在此设备上。无需账户，没有广告。购买通过 App Store 完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "計時資料儲存在此裝置上。無需帳號，沒有廣告。購買透過 App Store 完成。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El temporizador se guarda en este dispositivo. Sin cuenta ni anuncios. Las compras usan el App Store."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O timer fica neste dispositivo. Sem conta nem anúncios. As compras usam a App Store."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le minuteur reste sur cet appareil. Sans compte ni publicité. Les achats passent par l’App Store."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Timer bleibt auf diesem Gerät. Ohne Konto oder Werbung. Käufe erfolgen über den App Store."
          }
        }
      }
    },
    "On iPhone Duo, folding changes the layout, never the timer.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On iPhone Duo, folding changes the layout, never the timer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Duoでは折りたたむと配置が変わりますが、タイマーはそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Duo를 접으면 배치만 바뀌고 타이머는 그대로예요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone Duo 上，折叠只改变布局，不影响计时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone Duo 上，摺疊只改變版面，不影響計時。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En iPhone Duo, plegar cambia la distribución, nunca el temporizador."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No iPhone Duo, dobrar muda o layout, nunca o timer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur iPhone Duo, plier change la disposition, jamais le minuteur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem iPhone Duo ändert Falten das Layout, nie den Timer."
          }
        }
      }
    },
    "Notifications are off. Enable them in iOS Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications are off. Enable them in iOS Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知がオフです。iOSの設定から有効にできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 꺼져 있어요. iOS 설정에서 켜 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已关闭。请在 iOS 设置中开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已關閉。請在 iOS 設定中開啟。"
          }
        },
        "es": {
