    "Mochi, Pip, the timer, and all languages are free.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mochi, Pip, the timer, and all languages are free."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mochi、Pip、タイマー、すべての言語は無料です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mochi, Pip, 타이머와 모든 언어는 무료예요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mochi、Pip、计时功能和所有语言均免费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mochi、Pip、計時功能和所有語言均免費。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mochi, Pip, el temporizador y todos los idiomas son gratis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mochi, Pip, o timer e todos os idiomas são gratuitos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mochi, Pip, le minuteur et toutes les langues sont gratuits."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mochi, Pip, der Timer und alle Sprachen sind kostenlos."
          }
        }
      }
    },
    "Purchases use your Apple Account. Owned companions work offline.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchases use your Apple Account. Owned companions work offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入はApple Accountに紐づきます。購入済みのおともはオフラインでも使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매는 Apple 계정에 연결돼요. 보유한 친구들은 오프라인에서도 사용할 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "购买与 Apple 账户关联。已拥有的伙伴可离线使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "購買與 Apple 帳號關聯。已擁有的夥伴可離線使用。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las compras usan tu cuenta de Apple. Tus compañeros funcionan sin conexión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As compras usam sua Conta Apple. Os companheiros adquiridos funcionam offline."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les achats utilisent ton compte Apple. Les compagnons acquis fonctionnent hors ligne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Käufe sind mit deinem Apple Account verknüpft. Gekaufte Begleiter funktionieren offline."
          }
        }
      }
    },
    "Preview poses and voices. Your timer keeps running.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview poses and voices. Your timer keeps running."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表情や声を試せます。タイマーはそのまま動き続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표정과 목소리를 미리 확인해 보세요. 타이머는 계속 작동해요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览动作，试听语音。计时不会中断。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預覽動作，試聽語音。計時不會中斷。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba poses y voces. El temporizador sigue en marcha."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja poses e ouça vozes. O timer continua rodando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Découvre les poses et les voix. Le minuteur continue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Posen und Stimmen ansehen und anhören. Dein Timer läuft weiter."
          }
        }
      }
    },
    "Both companions, four poses each, all voice languages, scene and timer colors. No subscription.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both companions, four poses each, all voice languages, scene and timer colors. No subscription."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おとも2人、各4ポーズ、全言語の音声、背景、タイマーの配色。サブスクなし。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구 2명, 각각 포즈 4개, 모든 언어의 목소리, 배경과 타이머 색상. 구독 없음."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两位伙伴各四种动作、所有语言语音、场景和计时配色。无需订阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩位夥伴各四種動作、所有語言語音、場景和計時配色。無需訂閱。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos compañeros, cuatro poses cada uno, voces en todos los idiomas, escenario y colores. Sin suscripción."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dois companheiros, quatro poses cada, vozes em todos os idiomas, cenário e cores. Sem assinatura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux compagnons, quatre poses chacun, toutes les langues vocales, décor et couleurs. Sans abonnement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide Begleiter mit je vier Posen, allen Sprachversionen, Szene und Timerfarben. Kein Abo."
          }
        }
      }
    },
