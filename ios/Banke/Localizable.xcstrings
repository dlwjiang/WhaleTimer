    "All languages are free. Changing language does not reset your timer.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All languages are free. Changing language does not reset your timer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての言語が無料です。言語を変えてもタイマーはリセットされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 언어는 무료예요. 언어를 바꿔도 타이머는 초기화되지 않아요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有语言均免费。切换语言不会重置计时器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有語言均免費。切換語言不會重設計時器。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los idiomas son gratis. Cambiar de idioma no reinicia el temporizador."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os idiomas são gratuitos. Mudar o idioma não reinicia o temporizador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les langues sont gratuites. Changer de langue ne remet pas le minuteur à zéro."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Sprachen sind kostenlos. Ein Sprachwechsel setzt den Timer nicht zurück."
          }
        }
      }
    },
