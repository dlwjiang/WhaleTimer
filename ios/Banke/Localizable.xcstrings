    "Couldn’t restore purchases. Check your connection and Apple Account, then retry.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t restore purchases. Check your connection and Apple Account, then retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入を復元できませんでした。接続とApple Accountを確認して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매를 복원하지 못했어요. 연결과 Apple 계정을 확인한 후 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法恢复购买。请检查网络和 Apple 账户后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法回復購買。請檢查網路和 Apple 帳號後重試。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron restaurar las compras. Revisa tu conexión y cuenta de Apple y reintenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível restaurar as compras. Verifique a conexão e sua Conta Apple e tente novamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de restaurer les achats. Vérifiez la connexion et le compte Apple, puis réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Käufe konnten nicht wiederhergestellt werden. Prüfe Verbindung und Apple Account und versuche es erneut."
          }
        }
      }
    },
    "The App Store couldn’t verify this purchase. Restore purchases or retry.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store couldn’t verify this purchase. Restore purchases or retry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeで購入を確認できませんでした。購入を復元するか再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store에서 구매를 확인하지 못했어요. 구매를 복원하거나 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 无法验证此购买。请恢复购买或重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 無法驗證此購買。請回復購買或重試。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El App Store no pudo verificar la compra. Restaura las compras o reintenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A App Store não pôde verificar a compra. Restaure as compras ou tente novamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’App Store n’a pas pu vérifier cet achat. Restaurez les achats ou réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App Store konnte den Kauf nicht prüfen. Stelle Käufe wieder her oder versuche es erneut."
          }
        }
      }
    },
