          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おとも3人、各4ポーズ、全言語の音声、背景、タイマーの配色。サブスクなし。"
          }
        },
        "ko": {
          "stringUnit": {
