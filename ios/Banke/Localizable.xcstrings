    "Couldn’t enable reminders. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t enable reminders. Please try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知を有効にできませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림을 켜지 못했어요. 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法开启提醒，请重试。"
          }
