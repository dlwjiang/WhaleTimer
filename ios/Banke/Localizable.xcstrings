    "Activate to confirm a fresh focus session. You can also drag the handle to the right.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activate to confirm a fresh focus session. You can also drag the handle to the right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行するとリセットを確認できます。ハンドルを右にドラッグすることもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행하면 다시 시작을 확인할 수 있어요. 손잡이를 오른쪽으로 밀어도 돼요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "激活后确认重新开始，也可以将滑块拖到右侧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用後確認重新開始，也可以將滑塊拖到右側。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa para confirmar una nueva sesión. También puedes arrastrar el control a la derecha."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative para confirmar uma nova sessão. Você também pode arrastar o controle para a direita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez pour confirmer une nouvelle session. Vous pouvez aussi glisser le curseur vers la droite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren, um einen Neustart zu bestätigen. Du kannst den Griff auch nach rechts ziehen."
          }
        }
      }
    },
