    },
    "Some packs are unavailable. You can still preview them and use owned companions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some packs are unavailable. You can still preview them and use owned companions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のパックを購入できません。プレビューや購入済みのおともは使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 팩을 구매할 수 없어요. 미리 보기와 보유한 친구들은 계속 사용할 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分伙伴包暂时不可用。仍可预览和使用已拥有的伙伴。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分夥伴包暫時無法使用。仍可預覽和使用已擁有的夥伴。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos packs no están disponibles. Puedes verlos y usar tus compañeros."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns pacotes estão indisponíveis. Você pode vê-los e usar seus companheiros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains packs sont indisponibles. Les aperçus et compagnons acquis restent accessibles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Pakete sind nicht verfügbar. Vorschauen und gekaufte Begleiter bleiben nutzbar."
          }
        }
      }
    },
    "Couldn’t load the store. Check your connection and retry. Owned companions remain available.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t load the store. Check your connection and retry. Owned companions remain available."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストアを読み込めませんでした。接続を確認して再試行してください。購入済みのおともは使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스토어를 불러오지 못했어요. 연결을 확인하고 다시 시도해 주세요. 보유한 친구들은 계속 사용할 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载商店。请检查网络后重试。已拥有的伙伴仍可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入商店。請檢查網路後重試。已擁有的夥伴仍可使用。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar la tienda. Revisa tu conexión y reintenta. Tus compañeros siguen disponibles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar a loja. Verifique a conexão e tente novamente. Seus companheiros continuam disponíveis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger la boutique. Vérifiez la connexion et réessayez. Les compagnons acquis restent accessibles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Shop konnte nicht geladen werden. Prüfe die Verbindung und versuche es erneut. Gekaufte Begleiter bleiben verfügbar."
          }
        }
      }
    },
    "This pack is unavailable. Please try again later.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
