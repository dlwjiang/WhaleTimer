    "Reminders use iOS notifications. Focus modes and system settings may silence them.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders use iOS notifications. Focus modes and system settings may silence them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知にはiOSの通知機能を使います。集中モードやシステム設定により音が鳴らない場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 알림을 사용해요. 집중 모드나 시스템 설정에 따라 소리가 나지 않을 수 있어요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒通过 iOS 通知发送。专注模式和系统设置可能使通知静音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提醒透過 iOS 通知傳送。專注模式和系統設定可能使通知靜音。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los avisos usan notificaciones de iOS. Los modos de concentración y ajustes pueden silenciarlos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes usam notificações do iOS. Modos Foco e ajustes do sistema podem silenciá-los."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels utilisent les notifications iOS. Les modes de concentration et réglages peuvent les rendre silencieux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen nutzen iOS-Mitteilungen. Fokusmodi und Systemeinstellungen können sie stummschalten."
          }
        }
      }
    },
