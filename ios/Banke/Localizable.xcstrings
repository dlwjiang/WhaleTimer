          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Apple 帳號下未找到夥伴購買紀錄。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron compras de compañeros en esta cuenta de Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma compra de companheiros foi encontrada nesta Conta Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun achat de compagnon trouvé pour ce compte Apple."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Apple Account wurden keine Begleiterkäufe gefunden."
          }
        }
      }
