    "voice.pause": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a breath. I'll wait."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひと息つこう。待ってるね。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠깐 쉬어. 기다릴게."
